{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowglow",
  "version": "1.2.0",
  "identifier": "app.rowglow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowglow",
        "width": 1380,
        "height": 880,
        "minWidth": 940,
        "minHeight": 580,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Ask your data anything.",
    "longDescription": "Rowglow is a fast, local-first database client for PostgreSQL, MySQL, MariaDB, SQL Server, SQLite, DuckDB, Redis and MongoDB.",
    "copyright": "\u00a9 2026 Rowglow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}