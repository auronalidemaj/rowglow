# Settings for scripts/release-mac.sh. Copy to scripts/release-mac.env (ignored
# by git) and fill in. Nothing here is secret: the app-specific password lives
# in your keychain and the API key stays in its .p8 file. See docs/MAC-SIGNING.md.

# Your website. Built into the app for license activation and update checks.
ROWGLOW_API_BASE=https://rowglow.com

# Optional when your keychain has exactly one Developer ID Application certificate.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# Notarization: pick ONE of the two.

# A) App Store Connect API key (recommended; also what CI uses).
#    App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys.
# APPLE_API_KEY=ABC123DEF4
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
#    Defaults to ~/.appstoreconnect/private_keys/AuthKey_<APPLE_API_KEY>.p8
# APPLE_API_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8

# B) Apple ID + app-specific password. Store the password once with:
#    security add-generic-password -s rowglow-notary -a you@example.com -w
# APPLE_ID=you@example.com
# APPLE_TEAM_ID=ABCDE12345
